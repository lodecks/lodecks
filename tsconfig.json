{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/common/*": ["./packages/common/*"],
      "@/engine/*": ["./packages/engine/*"],
      "@/server/*": ["./packages/server/*"]
    }
  },
  "include": ["packages/common", "packages/server", "apps/api", "tests"]
}
