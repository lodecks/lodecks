{
  "name": "lodecks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently -n ui,api -c cyan,magenta \"bun run ui:dev\" \"bun run api:dev\"",
    "ui:dev": "bun run --cwd apps/ui dev",
    "ui:build": "bun run --cwd apps/ui build",
    "api:dev": "bun run --watch apps/api/index.ts",
    "test": "bun test packages tests",
    "typecheck": "tsc -p apps/ui --noEmit && tsc -p apps/api --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.12",
    "concurrently": "^9.2.1",
    "fflate": "^0.8.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.3"
  },
  "workspaces": ["packages/*", "apps/*"]
}
